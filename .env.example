# Copy to .env and fill in. .env is gitignored; this file is not.

# --- LLM -------------------------------------------------------------------
# ollama (local, free, slower) or anthropic (hosted, costs money, better)
LLM_PROVIDER=ollama

OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Jira ------------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
# Shared secret for webhook signature verification. Leave blank locally to
# accept unsigned webhooks; set it in any deployed environment.
JIRA_WEBHOOK_SECRET=

# --- HubSpot ---------------------------------------------------------------
# Private app token with crm.objects.contacts.read + .write
HUBSPOT_ACCESS_TOKEN=

# --- Runtime ---------------------------------------------------------------
CHROMA_DIR=./chroma_db
LOG_LEVEL=INFO
# true = log what would be posted instead of posting it. Keep true until
# you have watched a few real tickets go through.
ITRE_DRY_RUN=true
